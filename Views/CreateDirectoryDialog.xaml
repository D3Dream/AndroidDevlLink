<Window x:Class="AndroidDevLink.Views.CreateDirectoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建文件夹"
        Width="420"
        Height="205"
        MinWidth="360"
        MinHeight="190"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F6F8FA">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptTextBlock" Text="文件夹名称" FontWeight="SemiBold" Foreground="#24292F"/>
        <TextBox x:Name="DirectoryNameTextBox"
                 Grid.Row="1"
                 Height="32"
                 Margin="0,7,0,0"
                 Padding="8,0"
                 VerticalContentAlignment="Center"
                 MaxLength="255"
                 TextChanged="DirectoryNameTextBox_TextChanged"/>
        <TextBlock x:Name="ValidationTextBlock"
                   Grid.Row="2"
                   Margin="0,6,0,0"
                   Foreground="#CF222E"
                   TextWrapping="Wrap"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Width="76" Height="30" Margin="0,0,8,0" IsCancel="True"/>
            <Button x:Name="CreateButton"
                    Content="创建"
                    Width="76"
                    Height="30"
                    IsDefault="True"
                    IsEnabled="False"
                    Click="CreateButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
